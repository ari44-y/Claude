    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.91.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.9",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
